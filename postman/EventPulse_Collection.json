{
  "info": {
    "name": "EventPulse API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health Check",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] } }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set('token', jsonData.token);",
                  "    console.log('Token saved to environment!');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Admin User\",\n    \"email\": \"admin@eventpulse.com\",\n    \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set('token', jsonData.token);",
                  "    console.log('Token saved to environment!');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@eventpulse.com\",\n    \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "Get All Events (Filter/Paginate)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/events?city=Cairo&page=1&limit=5", "host": ["{{baseUrl}}"], "path": ["api", "events"], "query": [{ "key": "city", "value": "Cairo" }, { "key": "page", "value": "1" }, { "key": "limit", "value": "5" }] } }
        },
        {
          "name": "Get Event By ID",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/events/REPLACE_WITH_EVENT_ID", "host": ["{{baseUrl}}"], "path": ["api", "events", "REPLACE_WITH_EVENT_ID"] } }
        },
        {
          "name": "Create Event (Admin)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Node.js Workshop\",\n    \"description\": \"Learn backend development\",\n    \"category\": \"REPLACE_WITH_CATEGORY_ID\",\n    \"date\": \"2024-12-01T10:00:00Z\",\n    \"city\": \"Cairo\",\n    \"venue\": \"Tech Hub\",\n    \"capacity\": 50\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/events", "host": ["{{baseUrl}}"], "path": ["api", "events"] }
          }
        },
        {
          "name": "Update Event (Admin)",
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Advanced Node.js Workshop\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/events/REPLACE_WITH_EVENT_ID", "host": ["{{baseUrl}}"], "path": ["api", "events", "REPLACE_WITH_EVENT_ID"] }
          }
        },
        {
          "name": "Delete Event (Admin)",
          "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/api/events/REPLACE_WITH_EVENT_ID", "host": ["{{baseUrl}}"], "path": ["api", "events", "REPLACE_WITH_EVENT_ID"] } }
        }
      ]
    },
    {
      "name": "Registrations",
      "item": [
        {
          "name": "Register for Event",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"event\": \"REPLACE_WITH_EVENT_ID\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/registrations", "host": ["{{baseUrl}}"], "path": ["api", "registrations"] }
          }
        },
        {
          "name": "Get My Registrations",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/registrations/my", "host": ["{{baseUrl}}"], "path": ["api", "registrations", "my"] } }
        },
        {
          "name": "Cancel Registration",
          "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/api/registrations/REPLACE_WITH_REGISTRATION_ID", "host": ["{{baseUrl}}"], "path": ["api", "registrations", "REPLACE_WITH_REGISTRATION_ID"] } }
        }
      ]
    },
    {
      "name": "Announcements",
      "item": [
        {
          "name": "Send Announcement (Admin)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"eventId\": \"REPLACE_WITH_EVENT_ID\",\n    \"text\": \"The event is starting in 10 minutes!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/announcements", "host": ["{{baseUrl}}"], "path": ["api", "announcements"] }
          }
        },
        {
          "name": "Get Announcement History",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/announcements/REPLACE_WITH_EVENT_ID", "host": ["{{baseUrl}}"], "path": ["api", "announcements", "REPLACE_WITH_EVENT_ID"] } }
        }
      ]
    }
  ]
}